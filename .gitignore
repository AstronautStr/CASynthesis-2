__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
.venv/
*.egg-info/
dist/
build/

# local Claude Code settings (personal)
.claude/settings.local.json

# diagnostic / session render artifacts (large, regenerable by the probe scripts).
# Convention: write these to artifacts/ (cleaned during /dream consolidation).
artifacts/
_probe_*.wav
_probe_*.npy
_session_*.wav
_session_*.npz
smoke_*.txt

# Obsidian editor/workspace config (volatile per-session UI state, not shared)
.obsidian/
obsidian/.obsidian/

# rendered research-map image (regenerable: python render_canvas.py ResearchMap.canvas)
ResearchMap.png

# demo-bench experiment catalogs: records (record.json, state_end.*, notes.md) ARE
# versioned; audio and transient state are not (WAV is recomputable byte-exact via
# Check catalog / Check reproducibility from the record's pinned commit).
lab_catalog/local/
lab_catalog/**/worktrees/
lab_catalog/**/.verify/
lab_catalog/**/.tmp/
lab_catalog/**/replay/
lab_catalog/**/*.wav

# N0 network reference: float32 raw renders + probe sweep are regenerated by one command
demos/results/network_reference_n0/raw/

# the output device the prototype was last told to play into (local choice)
audio_device.json
